# ---------------------------------------------------------------------------
# SeguidorX — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite chaves reais.
# ---------------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fornecedor (backend only — NUNCA use prefixo NEXT_PUBLIC aqui)
BARATO_SOCIAIS_API_URL=https://baratosociais.com/api/v2
BARATO_SOCIAIS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo do cron de sincronização (/api/cron/sync-orders). Opcional em dev.
CRON_SECRET=

# Câmbio USD -> BRL usado para converter o custo do fornecedor (USD) em custo interno.
# Ajuste conforme necessário; usado apenas no backend/admin.
PROVIDER_USD_BRL_RATE=5.60

# Pagamentos (PIX)
# Recomendado: conectar o gateway pelo admin em /admin/pagamentos (as chaves ficam
# no banco). As variáveis abaixo servem só como FALLBACK inicial/dev.
#
# PAYMENT_PROVIDER: "mock" (dev), "asaas" ou "mercadopago". Se um gateway já foi
# ativado pelo admin, o valor salvo no banco tem prioridade sobre esta variável.
PAYMENT_PROVIDER=mock

# --- Asaas ---
# Chave de API do Asaas (Integrações -> Chaves API). Produção começa com "$aact_prod...".
ASAAS_API_KEY=
# Ambiente do Asaas: "production" (padrão) ou "sandbox".
ASAAS_ENV=production
# Opcional — força a URL base e ignora ASAAS_ENV (ex.: https://api.asaas.com/v3).
# ASAAS_API_URL=
# Token do webhook do Asaas (valida o header asaas-access-token). Compartilhado com o MP.
PAYMENT_WEBHOOK_SECRET=

# --- Mercado Pago (opcional) ---
# Access Token de produção do Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo da assinatura do webhook do Mercado Pago (x-signature).
MERCADOPAGO_WEBHOOK_SECRET=
