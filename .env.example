# ---------------------------------------------------------------------------
# SeguidorX — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite chaves reais.
# ---------------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fornecedor (backend only — NUNCA use prefixo NEXT_PUBLIC aqui)
BARATO_SOCIAIS_API_URL=https://baratosociais.com/api/v2
BARATO_SOCIAIS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo do cron de sincronização (/api/cron/sync-orders). Opcional em dev.
CRON_SECRET=

# Câmbio USD -> BRL usado para converter o custo do fornecedor (USD) em custo interno.
# Ajuste conforme necessário; usado apenas no backend/admin.
PROVIDER_USD_BRL_RATE=5.60

# Pagamentos (PIX)
# PAYMENT_PROVIDER: "mock" (dev) ou "asaas" (produção)
PAYMENT_PROVIDER=mock
# Chave de API do Asaas (Configurações -> Integrações -> API).
# Produção começa com "$aact_prod..." e sandbox com "$aact_hmlg...".
ASAAS_API_KEY=
# Ambiente do Asaas: "production" (padrão) ou "sandbox".
ASAAS_ENV=production
# Opcional — força a URL base e ignora ASAAS_ENV (ex.: https://api.asaas.com/v3).
# ASAAS_API_URL=
# Token do webhook do Asaas. Gere um valor forte e configure O MESMO no painel do
# Asaas (Integrações -> Webhooks). O backend valida o header asaas-access-token.
PAYMENT_WEBHOOK_SECRET=
